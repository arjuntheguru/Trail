{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "trail-api",
    "Audience": "trail-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "AllowSelfSignup": true
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@trail.local",
    "FromName": "Trail"
  },
  "Bootstrap": {
    "PlatformAdminEmail": null,
    "PlatformAdminPassword": null
  }
}