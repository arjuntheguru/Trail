{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Http": {
    "HttpsRedirection": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "MaxRequestBodyBytes": 1048576
  },
  "Jwt": {
    "Issuer": "trail-api",
    "Audience": "trail-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "AllowSelfSignup": true
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@trail.local",
    "FromName": "Trail",
    "SmtpSecurity": "StartTls",
    "SmtpTimeoutSeconds": 30
  },
  "Bootstrap": {
    "PlatformAdminEmail": null,
    "PlatformAdminPassword": null
  }
}