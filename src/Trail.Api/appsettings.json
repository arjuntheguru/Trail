{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
